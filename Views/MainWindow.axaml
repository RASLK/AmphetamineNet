<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AmphetamineNet.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="360"
        x:Class="AmphetamineNet.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="AmphetamineNet — Preferences"
        Width="420"
        Height="380"
        MinWidth="380"
        MinHeight="320"
        CanResize="True"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="14">
            <TextBlock Text="Advanced settings"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Text="Main controls live in the menu bar icon (top of the screen)."
                       Opacity="0.7"
                       TextWrapping="Wrap" />

            <Border CornerRadius="10"
                    Padding="14"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LidStatusText}" Opacity="0.8" />
                    <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
                    <TextBlock Text="{Binding ErrorText}"
                               IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="#E85D5D"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="These same options are in the tray menu:" Opacity="0.65" FontSize="12" />
            <CheckBox IsChecked="{Binding AllowClosedLid}" Content="Allow closed lid" />
            <CheckBox IsChecked="{Binding PreventDisplaySleep}" Content="Keep display awake" />

            <ComboBox ItemsSource="{Binding Durations}"
                      SelectedItem="{Binding SelectedDuration}"
                      HorizontalAlignment="Stretch" />

            <Button Content="{Binding ToggleButtonText}"
                    Command="{Binding ToggleSessionCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Height="40"
                    Classes="accent" />

            <Button Content="Save"
                    Command="{Binding SaveSettingsCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</Window>
