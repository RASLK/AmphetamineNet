<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AmphetamineNet.App"
             xmlns:local="using:AmphetamineNet"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <!-- TrayIcon is created in App.axaml.cs after DataContext — otherwise bindings are dead -->
</Application>
